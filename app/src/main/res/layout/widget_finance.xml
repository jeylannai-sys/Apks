<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_finance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:id="@+id/widget_finance_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_finance_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/finance_widget_name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_finance_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_status_today"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider line (using FrameLayout for RemoteViews safety) -->
    <FrameLayout
        android:id="@+id/widget_finance_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_finance_header"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#334155" />

    <!-- Net Balance Footer -->
    <TextView
        android:id="@+id/widget_finance_net"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_default_net_balance"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Two-column Income & Expenses -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/widget_finance_net"
        android:layout_below="@id/widget_finance_divider"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Income Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_label_income"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_finance_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_positive_currency"
                android:textColor="#34D399"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Expenses Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_label_expenses"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_finance_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_negative_currency"
                android:textColor="#F43F5E"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
